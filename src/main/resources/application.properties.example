# ============================================
# Student Management System — Example Configuration
# Copy to application-local.properties or set the environment variables below.
# Never commit real database passwords to version control.
# ============================================
spring.application.name=student-management-system

# MySQL Database Connection
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/student_management_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:change_me}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
# Use 'update' for local development; use 'validate' in production with database/setup.sql
spring.jpa.hibernate.ddl-auto=${DDL_AUTO:update}
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# Server
server.port=${SERVER_PORT:8080}

# CORS (comma-separated origins)
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:8080}
